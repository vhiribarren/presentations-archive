---
repoUrl: https://github.com/vhiribarren/presentations-archive
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Presentations · Vincent Hiribarren</title>
  <style>
    :root { --bg: #fafafa; --fg: #1a1a1a; --muted: #666; --card: #fff; --border: #e2e2e2; --accent: #2a7a3b; }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #0f0f23; --fg: #e8e8e8; --muted: #9a9ab0; --card: #17172e; --border: #2a2a4a; --accent: #00cc00; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; }
    main { max-width: 760px; margin: 0 auto; padding: 48px 16px; }
    h1 { margin: 0 0 4px; font-size: 1.8rem; }
    header p { margin: 0 0 32px; color: var(--muted); }
    ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    li { position: relative; }
    .card { display: grid; gap: 2px; padding: 16px 20px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; color: inherit; text-decoration: none; transition: border-color .15s; }
    .card:hover, .card:focus-visible { border-color: var(--accent); }
    .date { color: var(--muted); font-size: .85rem; }
    .title { font-size: 1.15rem; font-weight: 600; }
    .desc { color: var(--muted); }
    .source { position: absolute; top: 16px; right: 20px; font-size: .85rem; color: var(--muted); }
    .source:hover { color: var(--accent); }
    footer { margin-top: 40px; color: var(--muted); font-size: .85rem; }
    footer a { color: inherit; }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>Presentations</h1>
      <p>Talks by Vincent Hiribarren.</p>
    </header>
    <ul>
      {%- for p in presentations %}
      <li>
        <a class="card" href="./{{ p.dir }}/">
          <span class="date">{{ p.date | monthYear }}</span>
          <span class="title">{{ p.title }}</span>
          {%- if p.description %}
          <span class="desc">{{ p.description }}</span>
          {%- endif %}
        </a>
        <a class="source" href="{{ repoUrl }}/tree/main/{{ p.dir }}">source</a>
      </li>
      {%- endfor %}
    </ul>
    <footer>
      Content under <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>, code under MIT ·
      <a href="{{ repoUrl }}">GitHub</a>
    </footer>
  </main>
</body>
</html>
